<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- Container Konten yang dapat dirotasi secara manual (0°, 90°, 180°, 270°) -->
    <FrameLayout
        android:id="@+id/rotatableStage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center">

        <!-- 1. Komponen Penampil Gambar (Image Slide) -->
        <ImageView
            android:id="@+id/imageSlideView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Slide Image"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <!-- 2. Komponen Pemutar Video (ExoPlayer / Media3)
             Wajib menggunakan texture_view agar mendukung rotasi 90°/180°/270° secara mulus -->
        <androidx.media3.ui.PlayerView
            android:id="@+id/videoPlayerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:resize_mode="fit"
            app:surface_type="texture_view"
            app:use_controller="false" />

        <!-- 3. Layar Status / Loading / Info Koneksi -->
        <LinearLayout
            android:id="@+id/statusContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#090D16"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="48dp">

            <TextView
                android:id="@+id/tvStatusTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Menghubungkan ke Server..."
                android:textColor="#F8FAFC"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatusMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Menyinkronkan daftar playlist Digital Signage"
                android:textColor="#94A3B8"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvDeviceBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="#1E293B"
                android:paddingLeft="20dp"
                android:paddingTop="10dp"
                android:paddingRight="20dp"
                android:paddingBottom="10dp"
                android:text="CODE: TV-LOBBY-01"
                android:textColor="#38BDF8"
                android:textSize="16sp"
                android:typeface="monospace" />

            <Button
                android:id="@+id/btnOpenSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:backgroundTint="#2563EB"
                android:text="Pengaturan Server &amp; Rotasi (Tekan OK / Menu)"
                android:textColor="#FFFFFF" />
        </LinearLayout>

    </FrameLayout>

    <!-- 4. Panel Kontrol Cepat (Muncul saat layar diklik atau tombol OK/Menu ditekan, otomatis sembunyi 5 detik) -->
    <LinearLayout
        android:id="@+id/hudOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="20dp"
        android:background="#D90F172A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnQuickRotate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#0284C7"
            android:text="Rotasi: 0° (Landscape)"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnQuickScale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#0D9488"
            android:text="Skala: Fit"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnHudSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#334155"
            android:text="Pengaturan"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

</FrameLayout>
